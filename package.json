{
  "name": "pr-hero",
  "version": "1.0.0",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmaagd/pr-hero.git"
  },
  "homepage": "https://github.com/juanmaagd/pr-hero#readme",
  "bugs": {
    "url": "https://github.com/juanmaagd/pr-hero/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pr-hero": "./bin/pr-hero.js"
  },
  "preferGlobal": true,
  "files": [
    "bin",
    "dist",
    "prompts",
    "skills/pr-hero-triage",
    "skills/pr-hero-ci-setup",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts src/index.ts --target=bun --outdir=dist",
    "review": "bun run src/cli.ts",
    "fixture-eval": "bun run scripts/fixture-eval.ts",
    "refuter-probe": "bun run scripts/refuter-probe.ts",
    "check": "biome check src test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
